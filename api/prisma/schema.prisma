model SatelliteObservation {
  id                      String                     @id @default(uuid())
  mineId                  String
  provider                String                     @default("Copernicus Sentinel-2")
  satelliteName           String                     @default("Sentinel-2B")
  observationDate         DateTime
  acquisitionTimestamp    DateTime                   @default(now())
  cloudCoverage           Float                      @default(0.0)
  resolutionMeters        Float                      @default(10.0)
  spectralBands           Json?
  imageryUrl              String?
  ndviMean                Float?
  surfaceDisturbanceScore Float?                     @default(0.0)
  waterBodyAreaSqM        Float?
  changeDetected          Boolean                    @default(false)
  changeDetails           Json?
  processingStatus        String                     @default("COMPLETED")
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  mine                    Mine                       @relation(fields: [mineId], references: [id], onDelete: Cascade)
  events                  SatelliteMonitoringEvent[]

  @@index([mineId, observationDate])
  @@index([provider, processingStatus])
}

model SatelliteMonitoringEvent {
  id                   String                @id @default(uuid())
  mineId               String
  observationId        String?
  eventType            String
  severity             String                @default("MEDIUM")
  description          String
  descriptionHindi     String?
  detectedAt           DateTime              @default(now())
  confidenceScore      Float                 @default(0.85)
  status               String                @default("PENDING_FIELD_VERIFICATION")
  assignedInspectionId String?
  latitude             Float?
  longitude            Float?
  resolvedAt           DateTime?
  resolutionNote       String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  mine                 Mine                  @relation(fields: [mineId], references: [id], onDelete: Cascade)
  observation          SatelliteObservation? @relation(fields: [observationId], references: [id], onDelete: SetNull)

  @@index([mineId, status, detectedAt])
  @@index([eventType, severity])
}
