# ─── Khanan Suraksha Master Environment Configuration ────────────────────────
# Copy this file to .env and fill in your credentials

# ─── Supabase Cloud PostgreSQL Database ──────────────────────────────────────
DATABASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Google Gemini AI Intelligence Layer ─────────────────────────────────────
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# ─── High-Speed Indian SMS Gateway (Fast2SMS & Twilio DLT) ───────────────────
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_PHONE=

# ─── Redis Cache & Real-time Queues ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object Storage (MinIO / S3 Document Vault) ──────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=khanan-suraksha
MINIO_USE_SSL=false

# ─── Application Server & Security ───────────────────────────────────────────
PORT=4000
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SEED_DEFAULT_PASSWORD=

# ─── Frontend Environment Variables ──────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1